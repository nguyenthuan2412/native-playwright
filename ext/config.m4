dnl native_playwright: Playwright-style browser automation (CDP over pipe), no Node.js.
dnl Generated by tools/make-dist.sh - do not edit ext/config.m4 by hand.

PHP_ARG_ENABLE([native-playwright],
  [whether to enable native_playwright support],
  [AS_HELP_STRING([--disable-native-playwright], [Disable native_playwright support])],
  [yes])

PHP_ARG_WITH([gmp-dir],
  [for GMP/MPFR install prefix],
  [AS_HELP_STRING([[--with-gmp-dir[=DIR]]], [native_playwright: GMP and MPFR prefix (default: auto)])],
  [no], [no])

if test "$PHP_NATIVE_PLAYWRIGHT" != "no"; then
  PHP_REQUIRE_CXX()

  dnl ---- GMP / MPFR (needed by the PHPX runtime) ----
  NP_PREFIXES="$PHP_GMP_DIR /usr/local /opt/homebrew /opt/local"
  if test -x "$(command -v brew 2>/dev/null)"; then
    NP_PREFIXES="$(brew --prefix gmp 2>/dev/null) $(brew --prefix mpfr 2>/dev/null) $NP_PREFIXES"
  fi
  for hdr in gmp mpfr; do
    AC_MSG_CHECKING([for $hdr.h])
    NP_FOUND=no
    for p in $NP_PREFIXES; do
      if test "$p" != "no" && test -r "$p/include/$hdr.h"; then
        NP_FOUND=$p
        break
      fi
    done
    if test "$NP_FOUND" != "no"; then
      PHP_ADD_INCLUDE([$NP_FOUND/include])
      PHP_ADD_LIBPATH([$NP_FOUND/lib], NATIVE_PLAYWRIGHT_SHARED_LIBADD)
      AC_MSG_RESULT([$NP_FOUND])
    else
      echo "#include <$hdr.h>" > conftest_np.c
      if $CC $CPPFLAGS -E conftest_np.c >/dev/null 2>&1; then
        AC_MSG_RESULT([system])
      else
        rm -f conftest_np.c
        AC_MSG_ERROR([$hdr.h not found. Install lib$hdr-dev (Debian/Ubuntu), $hdr-devel (RHEL), "apk add $hdr-dev" (Alpine) or "brew install $hdr"; or pass --with-gmp-dir=PREFIX])
      fi
      rm -f conftest_np.c
    fi
  done
  PHP_ADD_LIBRARY(gmpxx, 1, NATIVE_PLAYWRIGHT_SHARED_LIBADD)
  PHP_ADD_LIBRARY(gmp, 1, NATIVE_PLAYWRIGHT_SHARED_LIBADD)
  PHP_ADD_LIBRARY(mpfr, 1, NATIVE_PLAYWRIGHT_SHARED_LIBADD)
  PHP_ADD_LIBRARY(stdc++, 1, NATIVE_PLAYWRIGHT_SHARED_LIBADD)

  case $host_os in
    darwin*) ;;
    *) PHP_ADD_LIBRARY(pthread, 1, NATIVE_PLAYWRIGHT_SHARED_LIBADD) ;;
  esac

  NP_DIR=PHP_EXT_SRCDIR(native_playwright)
  NP_INC="-I$NP_DIR -I$NP_DIR/generated/include -I$NP_DIR/phpx/include -I$NP_DIR/phpx/src/misc -I$NP_DIR/phpx/thirdparty/mpdecimal/libmpdec -I$NP_DIR/phpx/thirdparty/mpdecimal/libmpdec++ -I$NP_DIR/phpx/thirdparty/wren-gc/include"
  NP_CXXFLAGS="-std=c++17 -O2 -g0 -fPIC -fvisibility=hidden -fvisibility-inlines-hidden -Wno-deprecated-declarations -Wno-unused-variable -Wno-unused-function $NP_INC -include $NP_DIR/typephp_pch.hpp"
  NP_CFLAGS="-std=c11 -O2 -g0 -fPIC -fvisibility=hidden -DCONFIG_64 -DANSI -DHAVE_UINT128_T $NP_INC"

  PHP_NEW_EXTENSION(native_playwright, [generated/src/BlockingTransport.cc generated/src/Browser.cc generated/src/BrowserContext.cc generated/src/BrowserType.cc generated/src/CDPSession.cc generated/src/Connection.cc generated/src/ConsoleMessage.cc generated/src/Dialog.cc generated/src/Download.cc generated/src/FileChooser.cc generated/src/Frame.cc generated/src/FrameLocator.cc generated/src/JSError.cc generated/src/Keyboard.cc generated/src/Locator.cc generated/src/Mouse.cc generated/src/Page.cc generated/src/Playwright.cc generated/src/Request.cc generated/src/Response.cc generated/src/Route.cc generated/src/RouteHandler.cc generated/src/SwooleTransport.cc generated/src/Touchscreen.cc generated/src/Transport.cc generated/src/Util.cc generated/src/Waiter.cc generated/src/extension.cc generated/src/php_native_playwright_src_NativePlaywright_BrowserType_4c5677b1e9_class_constants.cc generated/src/php_native_playwright_src_NativePlaywright_Locator_206b2f41f4_class_constants.cc native/pipe.cc phpx/src/core/array.cc phpx/src/core/base.cc phpx/src/core/big_float.cc phpx/src/core/big_int.cc phpx/src/core/class.cc phpx/src/core/closure.cc phpx/src/core/debug.cc phpx/src/core/decimal.cc phpx/src/core/extension.cc phpx/src/core/foreach_iterator.cc phpx/src/core/keyword_method.cc phpx/src/core/native_gc.cc phpx/src/core/object.cc phpx/src/core/python_bridge.cc phpx/src/core/scope.cc phpx/src/core/string.cc phpx/src/core/type_check.cc phpx/src/core/variant.cc phpx/src/std/array.cc phpx/src/std/core.cc phpx/src/std/datetime.cc phpx/src/std/fs.cc phpx/src/std/hash.cc phpx/src/std/math.cc phpx/src/std/misc.cc phpx/src/std/string.cc phpx/src/typephp/typephp_attribute.cc phpx/src/typephp/typephp_call.cc phpx/src/typephp/typephp_fiber_generator.cc phpx/src/typephp/typephp_property.cc phpx/src/typephp/typephp_trait.cc phpx/thirdparty/mpdecimal/libmpdec++/decimal.cc ], $ext_shared, , [$NP_CXXFLAGS], cxx)
  PHP_ADD_SOURCES_X(PHP_EXT_DIR(native_playwright), [phpx/thirdparty/mpdecimal/libmpdec/basearith.c phpx/thirdparty/mpdecimal/libmpdec/constants.c phpx/thirdparty/mpdecimal/libmpdec/context.c phpx/thirdparty/mpdecimal/libmpdec/convolute.c phpx/thirdparty/mpdecimal/libmpdec/crt.c phpx/thirdparty/mpdecimal/libmpdec/difradix2.c phpx/thirdparty/mpdecimal/libmpdec/fnt.c phpx/thirdparty/mpdecimal/libmpdec/fourstep.c phpx/thirdparty/mpdecimal/libmpdec/io.c phpx/thirdparty/mpdecimal/libmpdec/mpalloc.c phpx/thirdparty/mpdecimal/libmpdec/mpdecimal.c phpx/thirdparty/mpdecimal/libmpdec/mpsignal.c phpx/thirdparty/mpdecimal/libmpdec/numbertheory.c phpx/thirdparty/mpdecimal/libmpdec/sixstep.c phpx/thirdparty/mpdecimal/libmpdec/transpose.c phpx/thirdparty/wren-gc/src/wren_gc.c ], [$NP_CFLAGS], shared_objects_native_playwright, yes)
  PHP_ADD_BUILD_DIR([$ext_builddir/generated/src $ext_builddir/native $ext_builddir/phpx/src/core $ext_builddir/phpx/src/std $ext_builddir/phpx/src/typephp $ext_builddir/phpx/thirdparty/mpdecimal/libmpdec $ext_builddir/phpx/thirdparty/mpdecimal/libmpdec++ $ext_builddir/phpx/thirdparty/wren-gc/src])
  PHP_ADD_EXTENSION_DEP(native_playwright, json)
  PHP_SUBST(NATIVE_PLAYWRIGHT_SHARED_LIBADD)
